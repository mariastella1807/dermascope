# Normalizacion de fin de linea.
#
# Sin esto, cada integrante del equipo que trabaje en otro sistema operativo vera
# diferencias en TODAS las lineas de los archivos que toque, y los merges se vuelven
# imposibles de revisar. Los archivos se guardan en LF en el repositorio y Git los
# entrega con el fin de linea nativo en el working copy.

* text=auto

# Scripts que deben conservar un fin de linea especifico
*.py   text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf

# Binarios: nunca aplicar conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.pt   binary
*.pth  binary
*.onnx binary
*.docx binary
*.ipynb binary
