# Entorno
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Configuracion local de cada integrante: rutas propias de datos y checkpoints.
# Se ignoran a proposito para que nadie sobrescriba las rutas de otro.
configs/*.local.yaml

# Datos: nunca versionar el dataset (licencia CC BY-NC y volumen)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Checkpoints y modelos exportados
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx

# Salidas de reportes: se versionan las tablas, no las figuras pesadas
reports/figures/*
!reports/figures/.gitkeep

# Sistema
.DS_Store
Thumbs.db

# Enunciado del curso: material del docente, se consulta en local pero no se publica
Proyecto_2_Vision_Computacional_Deep_Learning.docx
